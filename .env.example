# ── Desarrollo local (Docker Compose en la raíz del monorepo) ─────────────
# docker compose up -d
# Copia listo para usar: cp .env.development.example .env
# DATABASE_URL="postgresql://dutyjoy:dutyjoy_local@localhost:5432/dutyjoy_db"
# DIRECT_URL="postgresql://dutyjoy:dutyjoy_local@localhost:5432/dutyjoy_db"
# FRONTEND_URL="http://localhost:3001"
# BACKEND_URL="http://localhost:3000"
# ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000,http://localhost:5173"
# NODE_ENV=development

# ── Base de datos (Supabase — producción) ─────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo 64 caracteres aleatorios. NUNCA uses una frase legible.
JWT_SECRET="<64-char-hex-generado-con-crypto.randomBytes(64).toString('hex')>"

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
COMMISSION_RATE=0.15

# ── URLs (cambiar en producción) ──────────────────────────────────────────
FRONTEND_URL="https://app.dutyjoy.com"
BACKEND_URL="https://api.dutyjoy.com"
ALLOWED_ORIGINS="https://app.dutyjoy.com,https://dutyjoy.com"

# ── MercadoPago ───────────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.co/developers/panel/app
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxx"
MP_PUBLIC_KEY="APP_USR-xxxxxxxxxxxxxxxxxxxx"
# Webhook secret: copiar desde MP > Tus integraciones > Webhooks > Clave secreta
MP_WEBHOOK_SECRET="<clave-secreta-desde-panel-mp-webhooks>"
