# Copiar a .env para desarrollo local con Docker Compose:
#   cp .env.development.example .env
#
# Levantar Postgres: desde la raíz del monorepo → docker compose up -d

# ── Base de datos (PostgreSQL local) ─────────────────────────────────────
DATABASE_URL="postgresql://dutyjoy:dutyjoy_local@localhost:5432/dutyjoy_db"
DIRECT_URL="postgresql://dutyjoy:dutyjoy_local@localhost:5432/dutyjoy_db"

# ── Auth ──────────────────────────────────────────────────────────────────
# Genera uno real: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="juanroajs123123123"

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
COMMISSION_RATE=0.15

# ── URLs locales (frontend Next.js en :3001) ────────────────────────────────
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000,http://localhost:5173"

# ── MercadoPago (opcional en local) ───────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
